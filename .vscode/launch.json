{
   
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "venus",
            "request": "launch",
            "name": "Ask for file name",
            "program": "${workspaceFolder}/${command:AskForProgramName}",
            "stopOnEntry": true,
            "openViews": []
        },
        {
            "type": "venus",
            "request": "launch",
            "name": "Launch with all views",
            "program": "${file}",
            "stopOnEntry": true,
            "stopAtBreakpoints": true,
            "openViews": [
                "Robot",
                "LED Matrix",
                "Seven Segment Board",
                "Memory"
            ],
            "ledMatrixSize": {
                "x": 10,
                "y": 10
            }
        },
        {
            "type": "venus",
            "request": "launch",
            "name": "Debug Current File",
            "program": "${file}",
            "stopOnEntry": true,
            "openViews": []
        }
        

    ]
}